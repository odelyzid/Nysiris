{
  "manifest_version": 3,
  "name": "fly-protocol mixnet client",
  "version": "0.1.0",
  "description": "Desktop scaffold: route allow-listed hosts through the Nym mixnet.",
  "permissions": ["storage", "declarativeNetRequest", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "fly-protocol"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self' blob:"
  },
  "minimum_chrome_version": "120"
}
