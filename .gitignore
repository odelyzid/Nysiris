# Rust
/target
**/target

# Node / web
web/node_modules
web/dist
web/.vite

# Android / Gradle
web/android/.gradle
web/android/app/build
web/android/build
android/.gradle
*.apk
*.aab
*.keystore

# Desktop / packaging
dist/
desktop/build/
desktop/electron/web/
desktop/electron/dist/
desktop/electron/node_modules/

# TWA
twa-manifest.json
*.idsig

# Tooling
.DS_Store
*.log
