# Build context is the REPO ROOT (see docker-compose* build.context).
# Only these paths are used:
#   services/hybrid-bridge/Cargo.toml + Cargo.lock + src  (the bridge)
#   crates/bridge-guard, nym-hidden-service, portal-reputation,
#   provider-runtime                           (path dependencies)
# Everything else is excluded to keep the build context small.
.git/
**/target/
**/node_modules/
web/dist/
dist/
services/acceptance/
desktop/
extension/
android/
crates/sphinx-core/
services/echo-provider/
services/gateway/
*.log
