{
  "name": "nysiris-desktop",
  "private": true,
  "version": "0.1.18",
  "description": "Electron shell for the nysiris Nym mixnet client (alternative to the system-Chromium .deb).",
  "homepage": "https://github.com/tribewarez/nysiris",
  "author": {
    "name": "nysiris",
    "email": "noreply@example.com"
  },
  "license": "Apache-2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux deb AppImage"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.example.nysiris",
    "productName": "nysiris",
    "files": [
      "main.js",
      "web/**/*"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Network",
      "maintainer": "nysiris <noreply@example.com>",
      "icon": "build/icon.png"
    }
  }
}
